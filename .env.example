# Скопируйте в .env и проверьте значения командами id -u и id -g.
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Память: жёсткий предел и мягкая резервация для каждого сервиса.
# При больших библиотеках или транскодировании увеличьте предел Jellyfin.
QBITTORRENT_MEM_LIMIT=512m
QBITTORRENT_MEM_RESERVATION=128m
RADARR_MEM_LIMIT=1g
RADARR_MEM_RESERVATION=256m
SONARR_MEM_LIMIT=1g
SONARR_MEM_RESERVATION=256m
PROWLARR_MEM_LIMIT=512m
PROWLARR_MEM_RESERVATION=128m
JELLYFIN_MEM_LIMIT=2g
JELLYFIN_MEM_RESERVATION=512m
JELLYSEERR_MEM_LIMIT=1g
JELLYSEERR_MEM_RESERVATION=256m
FLARESOLVERR_MEM_LIMIT=2g
FLARESOLVERR_MEM_RESERVATION=256m
