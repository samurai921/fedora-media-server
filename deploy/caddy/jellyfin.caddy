# Фрагмент конфигурации Caddy на VPS, не на Fedora.
# Добавьте import этого файла в существующий Caddyfile после проверки.
# Если блок этого домена уже существует, не добавляйте второй.
# Backend остаётся на loopback VPS и обслуживается выделенным Xray.
jellyfin.mediadima.ru {
    reverse_proxy 127.0.0.1:18096
}
