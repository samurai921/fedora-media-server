{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "reality-in",
      "listen": "0.0.0.0",
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "decryption": "none",
        "clients": [
          {
            "id": "<VLESS_UUID>",
            "flow": "xtls-rprx-vision",
            "reverse": { "tag": "reverse-out" }
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "www.bing.com:443",
          "xver": 0,
          "serverNames": ["www.bing.com"],
          "privateKey": "<REALITY_PRIVATE_KEY>",
          "shortIds": ["<REALITY_SHORT_ID>"]
        }
      }
    },
    {
      "tag": "jellyfin-tunnel",
      "listen": "127.0.0.1",
      "port": 18096,
      "protocol": "tunnel",
      "settings": {
        "address": "127.0.0.1",
        "port": 8096,
        "network": "tcp"
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": ["jellyfin-tunnel"],
        "outboundTag": "reverse-out"
      }
    ]
  },
  "outbounds": [
    { "tag": "block-default", "protocol": "blackhole", "settings": {} }
  ]
}
