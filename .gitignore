# Локальные настройки, учётные данные и рабочие данные контейнеров
.env
config/**/*
!config/**/
!config/**/.gitkeep
data/**/*
!data/**/
!data/**/.gitkeep

# Резервные копии и временные файлы
*.bak
*.swp
*~

# Xray: только обезличенные *.example.json хранятся в Git
.env.*
!.env.example
*.env
!*.env.example
secrets/
private/
local/
config.json
config.*.json
!config.example.json
*-client-info.txt
client-info.txt
*.key
*.pem
*.log
*.dump
*.zip
*.tar
*.tar.gz
*.tgz
*.old
*.bak.*
*.env.*
!*.env.example
config.json.*
/deploy/xray-jellyfin/**/xray

# Python diagnostic scripts
__pycache__/
*.py[cod]
